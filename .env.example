# ===========================================================
#  FLENG - Configuracion
#
#  1. Copia este archivo y llamalo  .env
#  2. Pega tus claves donde dice (inserta_tu_clave...)
#  3. Guarda y ejecuta:  python app.py
# ===========================================================


# --- QUE PROVEEDOR USA CADA COSA ---------------------------

# Voz -> texto EN EL SERVIDOR.   Opciones: groq | deepgram | gemini | openai
# Siempre debe haber uno: es el respaldo cuando el navegador no puede.
STT_PROVIDER=groq

# Intentar primero el reconocimiento del navegador (gratis e instantaneo).
# Si el navegador no puede, la aplicacion pasa sola a STT_PROVIDER.
#
# No todos los navegadores pueden. Chrome manda el audio a un servicio de
# Google con una clave privada incrustada; Brave, Chromium, Opera y Electron
# no la llevan y fallan siempre con un error de "red" enganoso. Firefox no
# trae la API. En todos esos casos transcribe el servidor sin que tengas que
# tocar nada.
#
# Ponlo en false si prefieres que transcriba siempre el servidor.
STT_PREFER_BROWSER=true

# El modelo que conversa y traduce.   Opciones: groq | gemini | openai
LLM_PROVIDER=groq

# Texto -> voz.   Opciones: deepgram | openai | gemini | elevenlabs
TTS_PROVIDER=deepgram


# Nota: la pestana Tutorial funciona sin claves. Su contenido es texto
# fijo del servidor, no pasa por ninguna API.


# --- CLAVES ------------------------------------------------
# Solo necesitas la clave de los proveedores que elegiste arriba.

# Groq  ->  https://console.groq.com/keys
GROQ_API_KEY=(inserta_tu_clave_de_groq_aqui)

# Deepgram  ->  https://console.deepgram.com/signup
# Al registrarte te dan 200 dolares de credito gratis.
DEEPGRAM_API_KEY=(inserta_tu_clave_de_deepgram_aqui)

# OpenAI  ->  https://platform.openai.com/api-keys
# OPENAI_API_KEY=(inserta_tu_clave_aqui)

# Gemini  ->  https://aistudio.google.com/apikey
# Requiere ademas:  pip install google-genai
# GEMINI_API_KEY=(inserta_tu_clave_aqui)

# ElevenLabs  ->  https://elevenlabs.io/app/settings/api-keys
# ELEVENLABS_API_KEY=(inserta_tu_clave_aqui)


# --- AJUSTES OPCIONALES ------------------------------------
# Descomenta solo si algo falla o quieres cambiar la voz.

# Modelos de Groq. Cambialos si sale error 404 (modelo retirado).
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_SMART_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Voces de Deepgram. Cada voz habla UN idioma: por eso hay dos.
# Si sale error 404 al generar voz, prueba con aura-asteria-en (ingles).
# Lista completa: https://developers.deepgram.com/docs/tts-models
# DEEPGRAM_VOICE_EN=aura-2-thalia-en
# DEEPGRAM_VOICE_ES=aura-2-celeste-es
# DEEPGRAM_STT_MODEL=nova-2

# Voz de OpenAI (multilingue): alloy, echo, fable, onyx, nova, shimmer
# OPENAI_VOICE=nova

# Puerto del servidor
# PORT=5000

# --- VELOCIDAD ---------------------------------------------
# Longitud maxima de las respuestas, en tokens.
#
# Es la palanca de velocidad mas efectiva. Recorta por partida doble: el
# modelo genera menos y la sintesis de voz, que tarda en proporcion a los
# caracteres, tambien acaba antes. Subirlos da respuestas mas largas y
# esperas mas largas.
#
# MAX_TOKENS_CHAT=160
# MAX_TOKENS_TRANSLATE=300
# MAX_TOKENS_EVALUATE=900
